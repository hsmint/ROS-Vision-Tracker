          <mxGeometry x="20" y="10" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="states-2" value="active · dual_move · sequence · faulted 변수가 지금 상태를 나타냅니다. 이동 함수는 명령만 보내고 끝나며, 도착은 loop()가 100ms마다 확인합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="1300" height="24" as="geometry" />
        </mxCell>
