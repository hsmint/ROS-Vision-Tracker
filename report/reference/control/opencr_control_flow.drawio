        <mxCell id="states-4" value="&lt;b&gt;setup()&lt;/b&gt;&lt;br&gt;&lt;font style=&#39;font-size:10px&#39; color=&#39;#555555&#39;&gt;통신 시작, 설정·저장 위치 읽기,&lt;br&gt;파서 자체 점검&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="220" y="100" width="220" height="70" as="geometry" />
