Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 32; 34; 38
    Fixed Frame: root
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Color: 90; 90; 95
    - Class: rviz_default_plugins/RobotModel
      Name: CCTV Robot
      Enabled: true
      Alpha: 1
      Visual Enabled: true
      Collision Enabled: false
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Reliability Policy: Reliable
        Durability Policy: Transient Local
        History Policy: Keep Last
        Depth: 1
    - Class: rviz_default_plugins/Image
      Name: Tracking Image
      Enabled: true
      Transport Hint: raw
      Topic:
        Value: /tracking/image
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/PointCloud2
      Name: Flat Tracking Display
      Enabled: true
      Topic:
        Value: /tracking/image_plane
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Color Transformer: RGB8
      Position Transformer: XYZ
      Style: Squares
      Size (m): 0.0007
      Decay Time: 0
      Alpha: 1
    - Class: rviz_default_plugins/Marker
      Name: Target Marker
      Enabled: true
      Topic:
        Value: /target_marker
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 5
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: false
      Show Names: false
      Show Axes: true
      Show Arrows: false
      Marker Scale: 0.1
    - Class: rviz_default_plugins/Pose
      Name: Camera Pose
      Enabled: true
      Topic:
        Value: /camera/pose
        Reliability Policy: Reliable
        Durability Policy: Volatile
        History Policy: Keep Last
        Depth: 1
      Shape: Axes
      Axes Length: 0.08
      Axes Radius: 0.003
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Overview
      Distance: 1.0
      Pitch: 0.25
      Yaw: 0.5
      Near Clip Distance: 0.01
      Target Frame: <Fixed Frame>
      Focal Point:
        X: 0.1
        Y: -0.1
        Z: 0.0
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: Robot close-up
        Distance: 0.5
        Pitch: 0.3
        Yaw: 0.8
        Near Clip Distance: 0.005
        Target Frame: <Fixed Frame>
        Focal Point: {X: 0, Y: 0, Z: 0}
      - Class: rviz_default_plugins/Orbit
        Name: Tracking front view
        Distance: 0.7
        Pitch: 0
        Yaw: 0
        Near Clip Distance: 0.01
        Target Frame: tracking_image
        Focal Point: {X: 0.25, Y: 0, Z: 0}
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Value: true
Window Geometry:
  Width: 1440
  Height: 900
  Hide Left Dock: false
  Hide Right Dock: false
