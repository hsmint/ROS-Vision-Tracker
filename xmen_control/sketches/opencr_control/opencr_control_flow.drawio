<mxfile host="drawio" type="device"><diagram id="calls" name="1. 함수 호출 관계"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="calls-1" value="&lt;b&gt;opencr_control.ino 함수 호출 관계&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="calls-2" value="화살표 = 호출. 주황: setup()에서, 파랑: loop()에서, 초록: command()에서, 회색: 그 밖의 호출. 점선 = 조건부 호출" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1100" height="24" as="geometry"/></mxCell><mxCell id="calls-3" value="① 진입점" style="swimlane;startSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;rounded=1;arcSize=4;swimlaneFillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="20" y="80" width="220" height="820" as="geometry"/></mxCell><mxCell id="calls-4" value="② loop 단계 / 부팅 준비" style="swimlane;startSize=30;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;fontSize=14;rounded=1;arcSize=4;swimlaneFillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="270" y="80" width="240" height="820" as="geometry"/></mxCell><mxCell id="calls-5" value="③ 명령 분기" style="swimlane;startSize=30;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;rounded=1;arcSize=4;swimlaneFillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="540" y="80" width="230" height="820" as="geometry"/></mxCell><mxCell id="calls-6" value="④ 동작 함수" style="swimlane;startSize=30;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=14;rounded=1;arcSize=4;swimlaneFillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="800" y="80" width="270" height="820" as="geometry"/></mxCell><mxCell id="calls-7" value="⑤ 공통 부품" style="swimlane;startSize=30;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=14;rounded=1;arcSize=4;swimlaneFillColor=#fafafa;" vertex="1" parent="1"><mxGeometry x="1100" y="80" width="270" height="820" as="geometry"/></mxCell><mxCell id="calls-8" value="&lt;b&gt;setup()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;전원을 켤 때 한 번&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="180" height="60" as="geometry"/></mxCell><mxCell id="calls-9" value="&lt;b&gt;loop()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;계속 반복&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="180" height="60" as="geometry"/></mxCell><mxCell id="calls-10" value="&lt;b&gt;loadPosition()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;EEPROM에서 저장 위치 읽기&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="200" height="50" as="geometry"/></mxCell><mxCell id="calls-11" value="&lt;b&gt;readSerialInput()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;1단계: 매번, 최대 32글자&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="400" width="200" height="50" as="geometry"/></mxCell><mxCell id="calls-12" value="&lt;b&gt;checkAxesHealthy()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;2단계: 100ms마다 오류 점검&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1"><mxGeometry x="290" y="490" width="200" height="50" as="geometry"/></mxCell><mxCell id="calls-13" value="&lt;b&gt;updateDualMove()&lt;/b