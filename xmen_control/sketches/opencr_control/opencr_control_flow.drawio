tive="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="states" name="2. 실행 상태 흐름"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="states-1" value="&lt;b&gt;실행 상태 흐름&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=20;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="800" height="30" as="geometry"/></mxCell><mxCell id="states-2" value="active · dual_move · sequence · faulted 변수가 지금 상태를 나타냅니다. 이동 함수는 명령만 보내고 끝나며, 도착은 loop()가 100ms마다 확인합니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="20" y="40" width="1300" height="24" as="geometry"/></mxCell><mxCell id="states-3" value="전원 켜짐" style="ellipse;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="120" height="50" as="geometry"/></mxCell><mxCell id="states-4" value="&lt;b&gt;setup()&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px' color='#555555'&gt;통신 시작, 설정·저장 위치 읽기,&lt;br&gt;파서 자체 점검&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="220" y="100" width="220" height="70" as="geometry"/></mxCell><mxCell id="states-5" value="auto_home?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="95" width="140" height="80" as="geometry"/></mxCell><mxCell id="states-6" value="저장 위치와&lt;br&gt;같은가?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="230" width="150" height="90" as="geometry"/></mxCell><mxCell id="states-7" value="&lt;b&gt;IDLE (대기)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;active=false&lt;br&gt;토크 켜진 채 위치 유지&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="430" width="170" height="80" as="geometry"/></mxCell><mxCell id="states-8" value="&lt;b&gt;토크 꺼짐&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;configured=false&lt;br&gt;다음 이동 때 홈 기준 재계산&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1060" y="430" width="190" height="80" as="geometry"/></mxCell><mxCell id="states-9" value="&lt;b&gt;두 축 동시 이동&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;active=true, dual_move=true&lt;br&gt;updateDualMove()가 판정&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="620" width="220" height="80" as="geometry"/></mxCell><mxCell id="states-10" value="&lt;b&gt;순차 이동: Y축(tilt)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;active=true, sequence=true, stage=0&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="150" width="230" height="70" as="geometry"/></mxCell><mxCell id="states-11" value="&lt;b&gt;순차 이동: X축(pan)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;active=true, sequence=true, stage=1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1000" y="270" width="230" height="70" as="geometry"/></mxCell><mxCell id="states-12" value="&lt;b&gt;FAULT&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:10px'&gt;faulted=true, 새 이동 모두 거부&lt;br&gt;보드 재시작 전까지 유지&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="700" y="760" width="220" height="80" as="geometry"/></mxCell><mxCell id="states-13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="states-3" target="states-4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-14" value="OPENCR_READY" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="states-4" target="states-5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-15" value="on: startHome()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.3;" edge="1" parent="1" source="states-5" target="states-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-16" value="off: startRestore()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0;entryY=0.5;" edge="1" parent="1" source="states-5" target="states-6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-17" value="같음 (12틱 이내) / 저장 없음 / 모터 응답 없음" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="states-6" target="states-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-18" value="다름: RESTORE" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d79b00;fontColor=#d79b00;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.7;" edge="1" parent="1" source="states-6" target="states-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-19" value="REACHED tilt (5회 연속 도착)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="states-10" target="states-11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-20" value="DONE HOME / RESTORE → savePosition()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=1;entryY=0.25;" edge="1" parent="1" source="states-11" target="states-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-21" value="h" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.75;exitY=0;entryX=0.25;entryY=1;" edge="1" parent="1" source="states-7" target="states-10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-22" value="DX DY SPEED → moveBoth()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#82b366;fontColor=#82b366;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="states-7" target="states-9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-23" value="DONE XY → savePosition()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.75;" edge="1" parent="1" source="states-9" target="states-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-24" value="x: hold() + 저장" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0;entryY=0.25;" edge="1" parent="1" source="states-9" target="states-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-25" value="x" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.5;entryX=0.5;entryY=0;" edge="1" parent="1" source="states-11" target="states-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-26" value="off → release()" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.35;entryX=0;entryY=0.35;" edge="1" parent="1" source="states-7" target="states-8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-27" value="DX DY SPEED / h (prepareAxis로 재준비)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#666666;fontColor=#666666;fontSize=11;labelBackgroundColor=#ffffff;dashed=1;exitX=0;exitY=0.7;entryX=1;entryY=0.7;" edge="1" parent="1" source="states-8" target="states-7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-28" value="require() 실패: 통신·하드웨어 오류,&lt;br&gt;시간 초과 (어느 상태에서든)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#b85450;fontColor=#b85450;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;" edge="1" parent="1" source="states-7" target="states-12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="states-29" value="&lt;b&gt;BUSY&lt;/b&gt;: 이동 중 새 이동 명령은 거부합니다. 먼저 x로 멈춰야 합니다.&lt;br&gt;&lt;b&gt;p, scan&lt;/b&gt;: 상태가 바뀌지 않습니다 (scan은 이동 중 거부).&lt;br&gt;&lt;b&gt;x&lt;/b&gt;는 줄바꿈을 기다리지 않고 받는 즉시 멈춥니다." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="1000" y="620" width="380" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>